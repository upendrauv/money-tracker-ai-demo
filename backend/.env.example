# Server Port (Render sets this automatically)
PORT=8080

# Aiven MySQL Database Configuration
# From Aiven Console -> Service Overview -> Connection details:
# Host, Port, User, Password, Database Name (usually 'defaultdb')
DB_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_AIVEN_PORT/defaultdb?sslMode=REQUIRED
DB_USERNAME=avnadmin
DB_PASSWORD=YOUR_AIVEN_PASSWORD

# JWT Secret (minimum 256-bit secure string or Base64 key)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated URLs of your frontend)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-app.vercel.app

